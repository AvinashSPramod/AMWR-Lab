/* ==========================================================================
   AMWR Lab — Modern University Robotics Lab Theme
   Clean white canvas, deep slate text, NIT-inspired royal blue & teal accents
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');

:root {
  --brand-dark: #0b1f3a;      /* Deep academic midnight */
  --brand-primary: #1d4ed8;   /* Crisp royal engineering blue */
  --brand-teal: #0d9488;      /* Secondary robotics teal accent */
  --brand-tint: #eff6ff;      /* Soft blue tint for badges/highlights */
  --bg-body: #f8fafc;         /* Subtle off-white page background */
  --bg-card: #ffffff;         /* Pure white surface cards */
  --text-heading: #0f172a;
  --text-body: #334155;
  --text-muted: #64748b;
  --border: #e2e8f0;
  --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-md: 0 10px 25px -5px rgba(15, 23, 42, 0.07), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
  --radius: 12px;
  --max-width: 1140px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  color: var(--text-body);
  background-color: var(--bg-body);
  line-height: 1.7;
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, .brand-title {
  font-family: 'Plus Jakarta Sans', sans-serif;
  color: var(--text-heading);
  letter-spacing: -0.02em;
}

a {
  color: var(--brand-primary);
  text-decoration: none;
  transition: color 0.15s ease;
}

a:hover {
  color: #1e40af;
}

/* --- Clean White Academic Header with Accent Bar --- */
.site-header {
  background-color: #ffffff;
  border-top: 4px solid var(--brand-primary);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}

.nav-container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0.95rem 1.5rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.brand {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--brand-dark);
}

.brand-subtitle {
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--text-muted);
}

.nav-links {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
}

.nav-links a {
  color: var(--text-body);
  padding: 0.5rem 0.9rem;
  border-radius: 8px;
  font-size: 0.92rem;
  font-weight: 600;
  transition: all 0.15s ease;
}

.nav-links a:hover {
  background-color: var(--brand-tint);
  color: var(--brand-primary);
}

.nav-links a.active {
  background-color: var(--brand-primary);
  color: #ffffff;
}

/* --- Split Hero Section (INSPIRE Lab Style) --- */
.hero {
  background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
  border-bottom: 1px solid var(--border);
  padding: 4rem 1.5rem;
}

.hero-inner {
  max-width: var(--max-width);
  margin: 0 auto;
}

.hero-split {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: 2.5rem;
  align-items: center;
}

.hero-tag {
  display: inline-block;
  background-color: var(--brand-tint);
  color: var(--brand-primary);
  border: 1px solid #bfdbfe;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.32rem 0.85rem;
  border-radius: 999px;
  margin-bottom: 1.1rem;
}

.hero h1 {
  font-size: 2.4rem;
  font-weight: 800;
  line-height: 1.18;
  color: var(--brand-dark);
  margin-bottom: 1.1rem;
}

.hero p {
  font-size: 1.05rem;
  color: var(--text-body);
  margin-bottom: 1.75rem;
}

.hero-visual {
  background-color: #ffffff;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem;
  box-shadow: var(--shadow-md);
}

.hero-visual-box {
  background: linear-gradient(135deg, #eff6ff 0%, #f0fdfa 100%);
  border: 2px dashed #93c5fd;
  border-radius: 8px;
  min-height: 240px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 1.5rem;
  color: var(--brand-dark);
  font-weight: 600;
  font-size: 0.92rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
}

.btn {
  display: inline-block;
  padding: 0.7rem 1.45rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.94rem;
  transition: all 0.15s ease;
}

.btn-primary {
  background-color: var(--brand-primary);
  color: #ffffff;
  box-shadow: 0 2px 6px rgba(29, 78, 216, 0.25);
}

.btn-primary:hover {
  background-color: #1e40af;
  color: #ffffff;
  transform: translateY(-1px);
}

.btn-outline {
  background-color: #ffffff;
  border: 1px solid #cbd5e1;
  color: var(--text-heading);
}

.btn-outline:hover {
  border-color: var(--brand-primary);
  color: var(--brand-primary);
  background-color: var(--brand-tint);
}

/* --- Sub-page Banner --- */
.page-banner {
  background: linear-gradient(135deg, var(--brand-dark) 0%, #1e3a8a 100%);
  color: #ffffff;
  padding: 2.75rem 1.5rem;
}

.page-banner-inner {
  max-width: var(--max-width);
  margin: 0 auto;
}

.page-banner h1 {
  color: #ffffff;
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 0.4rem;
}

.page-banner p {
  color: #cbd5e1;
  font-size: 1.02rem;
  max-width: 720px;
}

/* --- Main Layout & Section Headings --- */
main.container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 3.25rem 1.5rem;
}

section {
  margin-bottom: 3.5rem;
}

.section-title {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--brand-dark);
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 5px;
  height: 1.35rem;
  background: linear-gradient(180deg, var(--brand-primary), var(--brand-teal));
  border-radius: 4px;
}

/* --- Cards & Grids --- */
.grid-3 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  gap: 1.5rem;
}

.card {
  background-color: var(--bg-card);
  border: 1px solid var(--border);
  border-top: 3px solid var(--brand-primary);
  border-radius: var(--radius);
  padding: 1.65rem;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.card h3 {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--brand-dark);
  margin-bottom: 0.65rem;
}

.card p {
  color: var(--text-body);
  font-size: 0.95rem;
}

/* --- News Feed --- */
.news-list {
  list-style: none;
  background-color: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.news-item {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  padding: 1.1rem 1.4rem;
  border-bottom: 1px solid var(--border);
  align-items: center;
}

.news-item:last-child {
  border-bottom: none;
}

.news-date {
  background-color: var(--brand-tint);
  color: var(--brand-primary);
  font-weight: 700;
  font-size: 0.8rem;
  padding: 0.25rem 0.65rem;
  border-radius: 6px;
  min-width: 95px;
  text-align: center;
}

/* --- Research Feature Cards --- */
.research-block {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 2rem;
  background-color: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.75rem;
  margin-bottom: 1.75rem;
  box-shadow: var(--shadow-sm);
  align-items: center;
}

.img-placeholder {
  background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  border: 2px dashed #94a3b8;
  border-radius: 8px;
  min-height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 1.25rem;
  color: var(--text-muted);
  font-size: 0.88rem;
  font-weight: 500;
}

.research-block h3 {
  font-size: 1.25rem;
  color: var(--brand-dark);
  margin-bottom: 0.6rem;
}

.research-block ul {
  margin-top: 0.85rem;
  padding-left: 1.25rem;
  color: var(--text-body);
  font-size: 0.95rem;
}

.research-block li {
  margin-bottom: 0.3rem;
}

/* --- People / PI Cards --- */
.pi-card {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 2rem;
  background-color: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 2rem;
  box-shadow: var(--shadow-sm);
  align-items: start;
}

.avatar-placeholder {
  width: 100%;
  aspect-ratio: 1 / 1;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border: 2px dashed #93c5fd;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 1rem;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--brand-primary);
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  margin-top: 1.15rem;
}

.badge {
  background-color: var(--brand-tint);
  color: var(--brand-primary);
  border: 1px solid #bfdbfe;
  padding: 0.3rem 0.8rem;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 600;
}

.badge:hover {
  background-color: var(--brand-primary);
  color: #ffffff;
}

/* --- Publications --- */
.pub-list {
  list-style: none;
}

.pub-item {
  background-color: var(--bg-card);
  border: 1px solid var(--border);
  border-left: 4px solid var(--brand-primary);
  border-radius: var(--radius);
  padding: 1.35rem 1.5rem;
  margin-bottom: 1.15rem;
  box-shadow: var(--shadow-sm);
}

.pub-badge {
  display: inline-block;
  font-size: 0.74rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 0.18rem 0.55rem;
  border-radius: 4px;
  margin-bottom: 0.45rem;
  background-color: #f0fdfa;
  color: var(--brand-teal);
  border: 1px solid #99f6e4;
}

.pub-title {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 1.06rem;
  font-weight: 700;
  color: var(--brand-dark);
  display: block;
  margin-bottom: 0.3rem;
}

.pub-authors {
  font-size: 0.94rem;
  color: var(--text-body);
  display: block;
}

.pub-venue {
  font-size: 0.9rem;
  font-style: italic;
  color: var(--text-muted);
  display: block;
  margin-top: 0.25rem;
}

.pub-links {
  margin-top: 0.7rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
}

.pub-links a {
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.22rem 0.65rem;
  background-color: var(--brand-tint);
  color: var(--brand-primary);
  border: 1px solid #bfdbfe;
  border-radius: 5px;
}

.pub-links a:hover {
  background-color: var(--brand-primary);
  color: #ffffff;
}

/* --- Openings Callout --- */
.callout-box {
  background: linear-gradient(135deg, #eff6ff 0%, #f0fdfa 100%);
  border: 1px solid #bfdbfe;
  border-left: 5px solid var(--brand-primary);
  padding: 1.5rem 1.75rem;
  border-radius: var(--radius);
  margin-bottom: 2rem;
}

.callout-box h3 {
  color: var(--brand-dark);
  margin-bottom: 0.4rem;
}

.styled-list {
  padding-left: 1.35rem;
  color: var(--text-body);
}

.styled-list li {
  margin-bottom: 0.5rem;
}

/* --- Footer --- */
.site-footer {
  background-color: var(--brand-dark);
  color: #94a3b8;
  padding: 2.75rem 1.5rem;
  margin-top: 4.5rem;
  font-size: 0.9rem;
}

.footer-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 1.5rem;
}

.footer-inner strong {
  color: #ffffff;
}

@media (max-width: 820px) {
  .hero-split,
  .research-block,
  .pi-card {
    grid-template-columns: 1fr;
  }
  .hero h1 {
    font-size: 1.85rem;
  }
  .avatar-placeholder {
    max-width: 180px;
  }
}
