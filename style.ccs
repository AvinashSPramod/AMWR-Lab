/* ==========================================================================
   AMWR Lab — Academic Lab Website Stylesheet
   Clean, structured, responsive design optimized for GitHub Pages
   ========================================================================== */

:root {
  --primary: #0f2942;       /* Deep academic navy */
  --primary-light: #1b436b;
  --accent: #0077b6;        /* Crisp engineering blue */
  --accent-soft: #e8f3fa;
  --bg-page: #ffffff;
  --bg-subtle: #f7f9fc;
  --text-main: #1e293b;
  --text-muted: #475569;
  --border: #e2e8f0;
  --radius: 8px;
  --max-width: 1120px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--text-main);
  background-color: var(--bg-page);
  line-height: 1.65;
  font-size: 16px;
}

a {
  color: var(--accent);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

/* --- Navigation Bar --- */
.site-header {
  background-color: var(--primary);
  color: #ffffff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(15, 41, 66, 0.12);
}

.nav-container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0.9rem 1.5rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.brand {
  display: flex;
  flex-direction: column;
  color: #ffffff;
  text-decoration: none;
}

.brand:hover {
  text-decoration: none;
}

.brand-title {
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: 0.2px;
}

.brand-subtitle {
  font-size: 0.78rem;
  color: #cbd5e1;
}

.nav-links {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
}

.nav-links a {
  color: #e2e8f0;
  padding: 0.45rem 0.85rem;
  border-radius: 5px;
  font-size: 0.92rem;
  font-weight: 500;
  transition: background-color 0.15s ease, color 0.15s ease;
}

.nav-links a:hover {
  background-color: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  text-decoration: none;
}

.nav-links a.active {
  background-color: var(--accent);
  color: #ffffff;
}

/* --- Hero & Page Banners --- */
.hero {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #ffffff;
  padding: 4rem 1.5rem;
}

.hero-inner,
.page-banner-inner,
.container {
  max-width: var(--max-width);
  margin: 0 auto;
}

.hero-tag {
  display: inline-block;
  background-color: rgba(255, 255, 255, 0.14);
  color: #e0f2fe;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  padding: 0.3rem 0.75rem;
  border-radius: 999px;
  margin-bottom: 1rem;
}

.hero h1 {
  font-size: 2.35rem;
  line-height: 1.2;
  margin-bottom: 1rem;
  max-width: 820px;
}

.hero p {
  font-size: 1.08rem;
  color: #e2e8f0;
  max-width: 740px;
  margin-bottom: 1.75rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
}

.btn {
  display: inline-block;
  padding: 0.65rem 1.35rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.94rem;
  transition: transform 0.1s ease, background-color 0.15s ease;
}

.btn:hover {
  text-decoration: none;
  transform: translateY(-1px);
}

.btn-primary {
  background-color: var(--accent);
  color: #ffffff;
}

.btn-primary:hover {
  background-color: #0284c7;
}

.btn-outline {
  border: 1px solid rgba(255, 255, 255, 0.5);
  color: #ffffff;
}

.btn-outline:hover {
  background-color: rgba(255, 255, 255, 0.1);
}

.page-banner {
  background-color: var(--bg-subtle);
  border-bottom: 1px solid var(--border);
  padding: 2.5rem 1.5rem;
}

.page-banner h1 {
  font-size: 1.95rem;
  color: var(--primary);
  margin-bottom: 0.4rem;
}

.page-banner p {
  color: var(--text-muted);
  max-width: 720px;
}

/* --- Main Content Sections --- */
main.container {
  padding: 3rem 1.5rem;
}

section {
  margin-bottom: 3.25rem;
}

section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 1.45rem;
  color: var(--primary);
  padding-bottom: 0.5rem;
  border-bottom: 2px solid var(--border);
  margin-bottom: 1.35rem;
}

/* --- Cards & Grids --- */
.grid-3 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  gap: 1.5rem;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  gap: 1.5rem;
}

.card {
  background-color: #ffffff;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
}

.card h3 {
  color: var(--primary);
  font-size: 1.15rem;
  margin-bottom: 0.6rem;
}

.card p {
  color: var(--text-muted);
  font-size: 0.96rem;
}

/* --- News List --- */
.news-list {
  list-style: none;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}

.news-item {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--border);
  align-items: baseline;
}

.news-item:last-child {
  border-bottom: none;
}

.news-date {
  font-weight: 700;
  font-size: 0.85rem;
  color: var(--accent);
  min-width: 110px;
}

/* --- Research Feature Rows --- */
.research-block {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 1.75rem;
  background-color: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  align-items: center;
}

.img-placeholder {
  background-color: #e2e8f0;
  border: 2px dashed #94a3b8;
  border-radius: 6px;
  min-height: 190px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 1rem;
  color: #475569;
  font-size: 0.88rem;
  font-weight: 500;
}

.research-block h3 {
  color: var(--primary);
  margin-bottom: 0.5rem;
  font-size: 1.2rem;
}

.research-block ul {
  margin-top: 0.75rem;
  padding-left: 1.2rem;
  color: var(--text-muted);
  font-size: 0.95rem;
}

/* --- People Cards --- */
.pi-card {
  display: grid;
  grid-template-columns: 190px 1fr;
  gap: 1.75rem;
  background-color: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.75rem;
  align-items: start;
}

.avatar-placeholder {
  width: 100%;
  aspect-ratio: 1 / 1;
  background-color: #e2e8f0;
  border: 2px dashed #94a3b8;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0.75rem;
  font-size: 0.85rem;
  color: #475569;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1rem;
}

.badge {
  background-color: var(--accent-soft);
  color: var(--primary);
  border: 1px solid #bae6fd;
  padding: 0.25rem 0.7rem;
  border-radius: 5px;
  font-size: 0.84rem;
  font-weight: 600;
}

/* --- Publications --- */
.pub-list {
  list-style: none;
}

.pub-item {
  padding: 1.1rem 1.25rem;
  border-left: 4px solid var(--accent);
  background-color: var(--bg-subtle);
  border-radius: 0 var(--radius) var(--radius) 0;
  margin-bottom: 1rem;
}

.pub-title {
  font-weight: 700;
  color: var(--primary);
  display: block;
  margin-bottom: 0.25rem;
}

.pub-authors {
  font-size: 0.93rem;
  color: var(--text-main);
  display: block;
}

.pub-venue {
  font-size: 0.9rem;
  font-style: italic;
  color: var(--text-muted);
  display: block;
  margin-top: 0.2rem;
}

.pub-links {
  margin-top: 0.5rem;
  display: flex;
  gap: 0.6rem;
}

.pub-links a {
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.15rem 0.55rem;
  border: 1px solid var(--accent);
  border-radius: 4px;
}

/* --- Openings Callout --- */
.callout-box {
  background-color: var(--accent-soft);
  border-left: 4px solid var(--accent);
  padding: 1.35rem 1.5rem;
  border-radius: 0 var(--radius) var(--radius) 0;
  margin-bottom: 1.75rem;
}

.callout-box h3 {
  color: var(--primary);
  margin-bottom: 0.4rem;
}

.styled-list {
  padding-left: 1.35rem;
  color: var(--text-main);
}

.styled-list li {
  margin-bottom: 0.45rem;
}

/* --- Footer --- */
.site-footer {
  background-color: var(--primary);
  color: #cbd5e1;
  padding: 2.25rem 1.5rem;
  margin-top: 4rem;
  font-size: 0.9rem;
}

.footer-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 1.5rem;
}

.footer-inner strong {
  color: #ffffff;
}

@media (max-width: 720px) {
  .hero h1 {
    font-size: 1.75rem;
  }
  .research-block,
  .pi-card {
    grid-template-columns: 1fr;
  }
  .avatar-placeholder {
    max-width: 180px;
  }
}
